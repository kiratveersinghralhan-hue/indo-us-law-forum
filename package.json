{
  "name": "editorial-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:rendered": "npm run build && vite build --ssr src/server/render.tsx --outDir dist-server",
    "build:review": "node scripts/build-review.mjs",
    "start:review": "node scripts/serve-review.mjs",
    "preview:rendered": "node scripts/serve-rendered.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:sql": "node scripts/check-sql.mjs",
    "check:content": "node scripts/content-tool.mjs validate",
    "check:prelaunch": "node scripts/content-tool.mjs prelaunch",
    "test:security": "supabase test db --local",
    "test:browser:backend": "playwright test --config playwright.backend.config.ts",
    "test:browser:security": "playwright test --config playwright.security.config.ts",
    "check:edge": "deno check supabase/functions/public-submission/index.ts supabase/functions/submission-notifications/index.ts",
    "test:edge:policy": "deno test --deny-net --allow-env=INTAKE_ENABLED,INTAKE_ALLOWED_ORIGINS,SUPABASE_URL,SUPABASE_SERVICE_ROLE_KEY,TURNSTILE_SECRET_KEY,INTAKE_RATE_PEPPER,NOTIFICATION_ENABLED,NOTIFICATION_PROVIDER supabase/functions/tests/delivery-policy.test.ts",
    "test:backend:http": "node scripts/backend-http-tests.mjs",
    "verify:dedicated:sql": "node scripts/verify-dedicated-sql.mjs",
    "verify:dedicated:http": "node scripts/verify-dedicated-backend.mjs"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.9.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "pgsql-parser": "18.2.9",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
